# DEV ONLY default (matches deploy/compose.dev.yaml). Staging/production: deploy/compose.yaml needs
# POSTGRES_PASSWORD set to a real secret, and DATABASE_URL must use it.
DATABASE_URL=postgres://pair:pair@127.0.0.1:55432/pair
# Required by deploy/compose.yaml (no default). Not used by deploy/compose.dev.yaml.
POSTGRES_PASSWORD=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
# Set to 1 to serve claude_code models through the `claude` CLI logged in with the owner subscription (no API key).
PAIR_CLAUDE_CODE=
# Path of the claude CLI (default: claude on PATH).
PAIR_CLAUDE_BIN=
TYPESAFE_API_KEY=

# Service bearer token; REQUIRED, must be at least 16 characters (generate with: openssl rand -hex 32).
PAIR_SERVICE_TOKEN=
# Listen address for pair-api (loopback by default).
PAIR_BIND=127.0.0.1:8080
# Directory holding forward SQL migrations. When set explicitly it must exist or the service refuses to start.
PAIR_MIGRATIONS_DIR=migrations
# Provider registry file; when set explicitly it must exist or the service refuses to start (unverified model ids are refused unless PAIR_ALLOW_UNVERIFIED_MODEL_IDS=1).
PAIR_MODELS_CONFIG=config/models.yaml
# Writable data directory (disk-space readiness probe target).
PAIR_DATA_DIR=
# Backup destination directory.
PAIR_BACKUP_DIR=
# age public key (age1...) used to encrypt backups.
PAIR_BACKUP_AGE_RECIPIENT=
# Path to the age identity (private key) file used for restore; keep it off this host.
PAIR_BACKUP_AGE_IDENTITY=
# Set to 1 only to explicitly allow plaintext backups.
PAIR_BACKUP_UNENCRYPTED=
# Name of the live database; scripts/restore refuses to replace it without PAIR_RESTORE_CONFIRM_LIVE=<name>.
PAIR_LIVE_DB=pair
# Per-invocation confirmations for scripts/restore; leave unset in this file and pass on the command line:
#   PAIR_RESTORE_CONFIRM_LIVE=<db>   restoring over PAIR_LIVE_DB
#   PAIR_RESTORE_CONFIRM_DROP=<db>   any use of --drop-existing

OPENCLAW_NO_AUTO_UPDATE=1
OPENCLAW_DISABLE_BONJOUR=1
CLAWHUB_DISABLE_TELEMETRY=1
