DATABASE_URL=postgres://pair:pair@127.0.0.1:55432/pair
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
TYPESAFE_API_KEY=

# Service bearer token; REQUIRED, must be at least 16 characters (generate with: openssl rand -hex 32).
PAIR_SERVICE_TOKEN=
# Listen address for pair-api (loopback by default).
PAIR_BIND=127.0.0.1:8080
# Directory holding forward SQL migrations.
PAIR_MIGRATIONS_DIR=migrations
# Provider registry file (unverified model ids are refused unless PAIR_ALLOW_UNVERIFIED_MODEL_IDS=1).
PAIR_MODELS_CONFIG=config/models.yaml
# Writable data directory (disk-space readiness probe target).
PAIR_DATA_DIR=
# Backup destination directory.
PAIR_BACKUP_DIR=
# age public key (age1...) used to encrypt backups.
PAIR_BACKUP_AGE_RECIPIENT=
# Path to the age identity (private key) file used for restore; keep it off this host.
PAIR_BACKUP_AGE_IDENTITY=
# Set to 1 only to explicitly allow plaintext backups.
PAIR_BACKUP_UNENCRYPTED=

OPENCLAW_NO_AUTO_UPDATE=1
OPENCLAW_DISABLE_BONJOUR=1
CLAWHUB_DISABLE_TELEMETRY=1
