{
  "id": "pair-spike",
  "name": "PAIR Spike",
  "description": "PAIR adapter: policy-gated tools, budget-gated model calls, reconciled usage",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "usageLogPath": { "type": "string" },
      "hookLogPath": { "type": "string" },
      "overrideProvider": { "type": "string" },
      "overrideModel": { "type": "string" },
      "taskKind": { "type": "string", "enum": ["default", "research", "coding"] },
      "priceVersion": { "type": "string" },
      "inputPricePerMtokMicros": { "type": "integer", "minimum": 1 },
      "outputPricePerMtokMicros": { "type": "integer", "minimum": 1 },
      "injectPolicyError": { "type": "boolean" }
    },
    "required": [
      "usageLogPath",
      "hookLogPath",
      "overrideProvider",
      "overrideModel",
      "taskKind",
      "priceVersion",
      "inputPricePerMtokMicros",
      "outputPricePerMtokMicros"
    ]
  }
}
