#!/usr/bin/env bash
# Stable PAIR check entry point: scripts/check <suite>
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT/service"
DEV_DATABASE_URL="postgres://pair:pair@127.0.0.1:55432/pair"
export DATABASE_URL="${DATABASE_URL:-$DEV_DATABASE_URL}"
suite="${1:-all}"

# Start the DEV-ONLY Postgres (deploy/compose.dev.yaml, fixed dev password) when the default dev
# database is not reachable. Never touches an explicitly configured DATABASE_URL.
ensure_dev_db() {
  [ "$DATABASE_URL" = "$DEV_DATABASE_URL" ] || return 0
  # shellcheck source=lib/pgtools.sh
  source "$ROOT/scripts/lib/pgtools.sh"
  if pg_init 2>/dev/null && pg_psql postgres -c 'SELECT 1' >/dev/null 2>&1; then return 0; fi
  command -v docker >/dev/null || { echo "check: dev database unreachable and docker not installed" >&2; return 1; }
  echo "check: starting dev Postgres from deploy/compose.dev.yaml" >&2
  docker compose -f "$ROOT/deploy/compose.dev.yaml" up -d --wait postgres
}

# Boot the real pair-api binary and assert the authenticated-service contract.
smoke() {
  local port="${PAIR_SMOKE_PORT:-18080}" base token
  base="http://127.0.0.1:${port}"
  token="smoke-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  log="$(mktemp)"; pid=""; scratch=""
  cargo clippy -p pair-api --all-targets -- -D warnings
  cargo test -p pair-api -- --test-threads=4
  cargo build -p pair-api --bin pair-api
  if curl -fs "$base/healthz" >/dev/null 2>&1; then
    echo "smoke: something already listens on $base; set PAIR_SMOKE_PORT" >&2; return 1
  fi
  # The binary runs migrations: give it its own scratch database, never the shared one.
  # shellcheck source=lib/pgtools.sh
  source "$ROOT/scripts/lib/pgtools.sh"
  pg_init
  scratch="pair_t_smoke_$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
  pg_psql postgres -c "CREATE DATABASE \"$scratch\"" >/dev/null
  DATABASE_URL="${DATABASE_URL%/*}/$scratch" PAIR_SERVICE_TOKEN="$token" PAIR_BIND="127.0.0.1:${port}" \
    PAIR_MIGRATIONS_DIR="$ROOT/migrations" PAIR_DATA_DIR="$ROOT" PAIR_MODELS_CONFIG="$ROOT/config/models.yaml" \
    PAIR_BUDGET_CONFIG="$ROOT/config/budget.yaml" PAIR_POLICY_CONFIG="$ROOT/config/policy.yaml" \
    PAIR_CONTEXT_CONFIG="$ROOT/config/context.yaml" PAIR_WORKSPACE_ROOT="$ROOT" \
    "${CARGO_TARGET_DIR:-./target}/debug/pair-api" >"$log" 2>&1 &
  pid=$!
  trap 'kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; rm -f "$log"; pg_psql postgres -c "DROP DATABASE IF EXISTS \"$scratch\" WITH (FORCE)" >/dev/null 2>&1 || true' EXIT
  local i
  for i in $(seq 1 60); do
    curl -fs "$base/healthz" >/dev/null 2>&1 && break
    kill -0 "$pid" 2>/dev/null || { echo "smoke: pair-api exited early" >&2; cat "$log" >&2; return 1; }
    sleep 0.5
  done
  expect_code() { # expected, description, curl args...
    local want="$1" what="$2" got; shift 2
    got="$(curl -s -o /dev/null -w '%{http_code}' "$@")"
    [ "$got" = "$want" ] || { echo "smoke FAIL: $what: want $want got $got" >&2; cat "$log" >&2; return 1; }
    echo "smoke ok: $what ($got)"
  }
  # 200 required, except a host whose disk is genuinely critical (readyz is correct to
  # say not-ready there): every non-disk check must still be non-critical.
  readyz_authenticated() {
    local out code body
    out="$(curl -s -w '\n%{http_code}' -H "Authorization: Bearer $token" -H "X-Actor: smoke" "$base/readyz")"
    code="${out##*$'\n'}"; body="${out%$'\n'*}"
    if [ "$code" = "200" ]; then echo "smoke ok: readyz authenticated (200)"; return 0; fi
    if [ "$code" = "503" ] && printf '%s' "$body" | python3 -c '
import json,sys
b=json.load(sys.stdin)
bad=[c["name"] for c in b["checks"] if c["level"]=="critical"]
sys.exit(0 if bad==["disk"] else 1)'; then
      echo "smoke ok: readyz authenticated (503: only disk critical on this host: $body)"; return 0
    fi
    echo "smoke FAIL: readyz authenticated: $code $body" >&2; cat "$log" >&2; return 1
  }
  expect_code 200 "healthz open" "$base/healthz"
  expect_code 401 "readyz without auth rejected" "$base/readyz"
  expect_code 401 "readyz with wrong token rejected" -H "Authorization: Bearer wrong-wrong-wrong-wrong" -H "X-Actor: smoke" "$base/readyz"
  expect_code 401 "readyz without X-Actor rejected" -H "Authorization: Bearer $token" "$base/readyz"
  readyz_authenticated
  # The hosted services: the routes exist in THIS binary, the data-class gate refuses before any
  # network or database work, and the policy engine and background tasks are live.
  expect_code 401 "turn without auth rejected" -X POST "$base/v1/turn"
  expect_code 403 "turn with employer data refused" -X POST -H "Authorization: Bearer $token" -H "X-Actor: smoke" \
    -H "Content-Type: application/json" -d '{"message":"payroll","data_class":"employer"}' "$base/v1/turn"
  local auth_body
  auth_body="$(curl -s -X POST -H "Authorization: Bearer $token" -H "X-Actor: smoke" -H "Content-Type: application/json" \
    -d '{"tool":"fs.read","args":[],"paths":[],"data_class":"public","policy_version":"stale"}' "$base/v1/policy/authorize")"
  printf '%s' "$auth_body" | grep -q '"decision":"deny"' || { echo "smoke FAIL: policy/authorize did not deny a stale version: $auth_body" >&2; cat "$log" >&2; return 1; }
  echo "smoke ok: policy engine hosted (stale policy version denied)"
  curl -s -H "Authorization: Bearer $token" -H "X-Actor: smoke" "$base/readyz" | grep -q '"name":"background"' \
    || { echo "smoke FAIL: readyz does not report background liveness" >&2; return 1; }
  echo "smoke ok: background liveness reported by readyz"
  local echoed trace_id="0199c0de-1234-7abc-8def-0123456789ab"
  echoed="$(curl -s -D - -o /dev/null -H "X-Trace-Id: $trace_id" "$base/healthz" | tr -d '\r' | awk -F': ' 'tolower($1)=="x-trace-id"{print $2}')"
  [ "$echoed" = "$trace_id" ] || { echo "smoke FAIL: UUID trace id not echoed ($echoed)" >&2; return 1; }
  echoed="$(curl -s -D - -o /dev/null -H "X-Trace-Id: smoke-trace-1" "$base/healthz" | tr -d '\r' | awk -F': ' 'tolower($1)=="x-trace-id"{print $2}')"
  [[ "$echoed" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || { echo "smoke FAIL: non-UUID trace id not replaced ($echoed)" >&2; return 1; }
  echo "smoke ok: trace id propagated (UUID kept, non-UUID replaced)"
  echo "smoke: PASS"
}

case "$suite" in
  policy) crate=policy ;;
  budget) crate=budget ;;
  providers) crate=models ;;
  routing) crate=models ;;
  memory-store|memory-inbox|memory) crate=memory ;;
  context) crate=context ;;
  recovery) crate=jobs ;;
  daily|research|coding|personal-integrations) crate=workflows ;;
  smoke) ensure_dev_db; smoke; exit ;;
  release)
    ensure_dev_db
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets -- -D warnings
    cargo test --workspace
    for s in "$ROOT"/scripts/backup "$ROOT"/scripts/restore "$ROOT"/scripts/restore-drill "$ROOT"/scripts/check "$ROOT"/scripts/lib/*.sh "$ROOT"/scripts/tests/*.sh; do bash -n "$s"; done
    for t in "$ROOT"/scripts/tests/*.sh; do bash "$t"; done
    smoke
    # Restore drill on a seeded scratch database (pair_drill_*). Unencrypted unless an age
    # recipient is configured; the encrypted path is only exercised when age is set up.
    if [ -z "${PAIR_BACKUP_AGE_RECIPIENT:-}" ]; then export PAIR_BACKUP_UNENCRYPTED=1; fi
    "$ROOT/scripts/restore-drill" --seed-demo
    echo "release: automated checks passed. Gates in docs/release-checklist.md remain UNMEASURED until evaluated."
    exit ;;
  all) ensure_dev_db; cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace; exit ;;
  *) echo "unknown suite: $suite" >&2; exit 2 ;;
esac
ensure_dev_db
cargo clippy -p "pair-$crate" --all-targets -- -D warnings
cargo test -p "pair-$crate" -- --test-threads=4
